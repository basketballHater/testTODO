# Optional overrides for docker-compose (everything has a working default).
# Copy to `.env` to change them.

FRONTEND_PORT=8080
BACKEND_PORT=8000
DB_HOST_PORT=3307

DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# Seed the five demo tasks from the UI mockup on first start.
DB_SEED=true

# Leave empty to generate a throw-away key on every container start.
APP_KEY=
